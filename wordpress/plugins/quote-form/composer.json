{
	"name": "jhums04/quote-form",
	"description": "Quote form that saves submissions and delivers them to n8n.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^10.5",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"autoload": {
		"psr-4": {
			"QuoteForm\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"QuoteForm\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.1.0"
		},
		"sort-packages": true
	}
}

{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "black",
					"name": "Ink",
					"color": "#1F1A17"
				},
				{
					"slug": "gray-600",
					"name": "Taupe",
					"color": "#6B6259"
				},
				{
					"slug": "gray-200",
					"name": "Line",
					"color": "#E6DED2"
				},
				{
					"slug": "gray-50",
					"name": "Sand",
					"color": "#F3ECE1"
				},
				{
					"slug": "paper",
					"name": "Cream",
					"color": "#FBF7F0"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "charcoal",
					"name": "Wine",
					"color": "#5A231F"
				},
				{
					"slug": "on-dark",
					"name": "Text on Wine",
					"color": "#F3E3DB"
				},
				{
					"slug": "accent",
					"name": "Oxblood",
					"color": "#8C2F2B"
				},
				{
					"slug": "accent-dark",
					"name": "Oxblood Deep",
					"color": "#6E2420"
				},
				{
					"slug": "accent-tint",
					"name": "Stone",
					"color": "#E8E1D3"
				},
				{
					"slug": "accent-light",
					"name": "Brass",
					"color": "#D6BE94"
				},
				{
					"slug": "error",
					"name": "Error",
					"color": "#B91C1C"
				},
				{
					"slug": "error-background",
					"name": "Error Background",
					"color": "#FEF2F2"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#15803D"
				},
				{
					"slug": "success-background",
					"name": "Success Background",
					"color": "#F0FDF4"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 1px 2px rgba(31, 26, 23, 0.05), 0 16px 40px -16px rgba(31, 26, 23, 0.22)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "1",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "2",
					"size": "1rem"
				},
				{
					"slug": "30",
					"name": "3",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "4",
					"size": "2rem"
				},
				{
					"slug": "50",
					"name": "5",
					"size": "4rem"
				},
				{
					"slug": "60",
					"name": "6",
					"size": "6rem"
				},
				{
					"slug": "section",
					"name": "Section",
					"size": "clamp(4.5rem, 10vw, 7.5rem)"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Fraunces",
							"fontWeight": "600",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-600-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.25rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "3.75rem",
					"fluid": {
						"min": "2.375rem",
						"max": "3.75rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|black"
		},
		"spacing": {
			"padding": {
				"left": "var:preset|spacing|20",
				"right": "var:preset|spacing|20"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|black"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|black",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "600",
					"lineHeight": "1.12",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.04",
					"letterSpacing": "-0.025em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.25"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.25"
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|gray-600"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|white"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-dark",
						"text": "var:preset|color|white"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|black",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var:preset|color|black"
						},
						"border": {
							"color": "var:preset|color|black",
							"width": "1px",
							"style": "solid"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|gray-200"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|black"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|black"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}

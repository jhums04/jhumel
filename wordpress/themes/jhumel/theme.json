{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "black",
					"name": "Ink",
					"color": "#0A0A0A"
				},
				{
					"slug": "gray-600",
					"name": "Gray 600",
					"color": "#57534E"
				},
				{
					"slug": "gray-200",
					"name": "Gray 200",
					"color": "#E7E3DA"
				},
				{
					"slug": "gray-50",
					"name": "Gray 50",
					"color": "#F3F0E8"
				},
				{
					"slug": "paper",
					"name": "Paper",
					"color": "#FAF8F3"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#FFFFFF"
				},
				{
					"slug": "navy",
					"name": "Navy",
					"color": "#0E1B3D"
				},
				{
					"slug": "navy-hover",
					"name": "Navy Hover",
					"color": "#24345F"
				},
				{
					"slug": "navy-muted",
					"name": "Navy Muted Text",
					"color": "#C7D0E6"
				},
				{
					"slug": "sky",
					"name": "Sky",
					"color": "#93C5FD"
				},
				{
					"slug": "amber",
					"name": "Amber",
					"color": "#F59E0B"
				},
				{
					"slug": "amber-50",
					"name": "Amber 50",
					"color": "#FEF3C7"
				},
				{
					"slug": "amber-dark",
					"name": "Amber Dark",
					"color": "#92400E"
				},
				{
					"slug": "error",
					"name": "Error",
					"color": "#B91C1C"
				},
				{
					"slug": "error-background",
					"name": "Error Background",
					"color": "#FEF2F2"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#15803D"
				},
				{
					"slug": "success-background",
					"name": "Success Background",
					"color": "#F0FDF4"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 1px 2px rgba(14, 27, 61, 0.06), 0 16px 40px -16px rgba(14, 27, 61, 0.22)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "10",
					"name": "1",
					"size": "0.5rem"
				},
				{
					"slug": "20",
					"name": "2",
					"size": "1rem"
				},
				{
					"slug": "30",
					"name": "3",
					"size": "1.5rem"
				},
				{
					"slug": "40",
					"name": "4",
					"size": "2rem"
				},
				{
					"slug": "50",
					"name": "5",
					"size": "4rem"
				},
				{
					"slug": "60",
					"name": "6",
					"size": "6rem"
				},
				{
					"slug": "section",
					"name": "Section",
					"size": "clamp(4.5rem, 10vw, 7.5rem)"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-600-normal.woff2"
							]
						},
						{
							"fontFamily": "Fraunces",
							"fontWeight": "600",
							"fontStyle": "italic",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces-600-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.25rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "2rem",
					"fluid": {
						"min": "1.625rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "3.75rem",
					"fluid": {
						"min": "2.375rem",
						"max": "3.75rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|black"
		},
		"spacing": {
			"padding": {
				"left": "var:preset|spacing|20",
				"right": "var:preset|spacing|20"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|navy"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|black"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|navy",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontWeight": "600",
					"lineHeight": "1.12",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.04",
					"letterSpacing": "-0.025em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.25"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.25"
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|gray-600"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|navy",
					"text": "var:preset|color|white"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|amber",
						"text": "var:preset|color|black"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|navy",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var:preset|color|black"
						},
						"border": {
							"color": "var:preset|color|black",
							"width": "1px",
							"style": "solid"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|gray-200"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|serif",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|black"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|black"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}

{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "black", "name": "Black", "color": "#0A0A0A" },
				{ "slug": "gray-600", "name": "Gray 600", "color": "#525252" },
				{ "slug": "gray-200", "name": "Gray 200", "color": "#E5E5E5" },
				{ "slug": "gray-50", "name": "Gray 50", "color": "#F7F7F7" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "blue", "name": "Blue", "color": "#1D4ED8" },
				{ "slug": "blue-dark", "name": "Blue Dark", "color": "#1E3A8A" },
				{ "slug": "error", "name": "Error", "color": "#B91C1C" },
				{ "slug": "error-background", "name": "Error Background", "color": "#FEF2F2" },
				{ "slug": "success", "name": "Success", "color": "#15803D" },
				{ "slug": "success-background", "name": "Success Background", "color": "#F0FDF4" }
			]
		},
		"layout": { "contentSize": "720px", "wideSize": "1080px" },
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "1rem" },
				{ "slug": "30", "name": "3", "size": "1.5rem" },
				{ "slug": "40", "name": "4", "size": "2rem" },
				{ "slug": "50", "name": "5", "size": "4rem" },
				{ "slug": "60", "name": "6", "size": "6rem" },
				{ "slug": "section", "name": "Section", "size": "clamp(4rem, 10vw, 6rem)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.75rem", "fluid": false },
				{ "slug": "x-large", "name": "Extra Large", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|white", "text": "var:preset|color|black" },
		"spacing": {
			"padding": { "left": "var:preset|spacing|20", "right": "var:preset|spacing|20" }
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|blue" },
				":hover": { "color": { "text": "var:preset|color|blue-dark" } },
				":focus": { "outline": { "color": "var:preset|color|blue", "offset": "2px", "style": "solid", "width": "2px" } }
			},
			"heading": { "typography": { "fontWeight": "700", "lineHeight": "1.2" } },
			"h1": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"button": {
				"color": { "background": "var:preset|color|blue", "text": "var:preset|color|white" },
				"border": { "radius": "4px" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem" } },
				"typography": { "fontWeight": "600" },
				":hover": { "color": { "background": "var:preset|color|blue-dark" } },
				":focus": { "outline": { "color": "var:preset|color|blue", "offset": "2px", "style": "solid", "width": "2px" } }
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"color": { "background": "transparent", "text": "var:preset|color|black" },
						"border": { "color": "var:preset|color|black", "width": "1px", "style": "solid" }
					}
				}
			},
			"core/separator": { "color": { "text": "var:preset|color|gray-200" } },
			"core/site-title": {
				"typography": { "fontSize": "var:preset|font-size|medium", "fontWeight": "700" },
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|black" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|black" },
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}

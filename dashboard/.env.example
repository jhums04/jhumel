# Copy to .env. Both values are printed by `supabase status` (API_URL and PUBLISHABLE_KEY).
# The publishable key is safe in the browser: row-level security decides what each user can read.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. When both are set, the login page offers a "Fill in demo login" button.
VITE_DEMO_EMAIL=demo@jhumel.dev
VITE_DEMO_PASSWORD=

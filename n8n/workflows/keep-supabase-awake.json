{
  "id": "keepSupabaseAwake1",
  "name": "Keep Supabase awake",
  "active": false,
  "nodes": [
    {
      "id": "6b1f2c3d-4e5a-4b6c-8d7e-9f0a1b2c3d41",
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "7c2a3d4e-5f6b-4c7d-9e8f-0a1b2c3d4e52",
      "name": "Touch the database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "localSupabasePg1",
          "name": "Supabase Postgres"
        }
      },
      "notes": "Supabase pauses free projects after a week without activity. One small query a day keeps the demo awake.",
      "parameters": {
        "operation": "executeQuery",
        "query": "select count(*) as organizations from public.organizations;",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Touch the database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "errorAlertFlow01"
  },
  "pinData": {}
}

# Copy to .env and fill in the empty values.

N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila

# The lead webhook signature check runs in a Code node and needs Node's crypto module.
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# Must match the webhook secret on the quote form plugin settings page.
LEAD_WEBHOOK_SECRET=

# host.docker.internal reaches `supabase start` on the host machine.
SUPABASE_URL=http://host.docker.internal:54321
# PUBLISHABLE_KEY from `supabase status`. n8n sends it with the dashboard user's token to check who is signed in.
SUPABASE_PUBLISHABLE_KEY=

DASHBOARD_URL=http://localhost:5173

# Lead alerts. Your own chat id: message @userinfobot (blue verified badge) and copy the Id.
TELEGRAM_PRIVATE_CHAT_ID=
# The public demo channel's username, with @. The bot must be an admin that can post.
TELEGRAM_DEMO_CHAT_ID=@your_channel

# Follow-up replies sent from the dashboard. Locally they are caught by Mailpit (http://localhost:54324);
# in production they go out through Gmail SMTP, so FOLLOW_UP_FROM must be the Gmail account itself.
FOLLOW_UP_FROM=you@gmail.com
FOLLOW_UP_REPLY_TO=you@gmail.com

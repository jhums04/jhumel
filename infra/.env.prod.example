# Production settings for infra/docker-compose.prod.yml. Copy to infra/.env.prod on the server only
# (never commit it) and fill in every empty value. Generate secrets with: openssl rand -hex 32

# --- Domains ---------------------------------------------------------------------------------------
SITE_DOMAIN=bongancisojhumel.com
N8N_DOMAIN=n8n.bongancisojhumel.com
DASHBOARD_URL=https://app.bongancisojhumel.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=

# --- WordPress ---------------------------------------------------------------------------------------
WORDPRESS_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
# Eight unique random values. One way: curl -s https://api.wordpress.org/secret-key/1.1/salt/
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=
# The shared demo login shown on the homepage. It must match the demo user in Supabase.
DEMO_EMAIL=demo@bongancisojhumel.com
DEMO_PASSWORD=

# --- n8n -----------------------------------------------------------------------------------------------
N8N_DB_PASSWORD=
# Keep a copy in your password manager: without it n8n cannot read its saved credentials after a restore.
N8N_ENCRYPTION_KEY=
# Must match the webhook secret on the quote form plugin's settings page.
LEAD_WEBHOOK_SECRET=
# From the Supabase Cloud project: Settings > API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
TELEGRAM_PRIVATE_CHAT_ID=
TELEGRAM_DEMO_CHAT_ID=@jhumelbuilds_demo
# Gmail sends follow-ups, so this must be the Gmail account itself.
FOLLOW_UP_FROM=
FOLLOW_UP_REPLY_TO=

# --- Backups -------------------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/lead-engine
BACKUP_KEEP_DAYS=14
